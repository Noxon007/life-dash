# Secrets & lokale Konfiguration
.env
backend/.env
.claude/settings.local.json

# Datenbanken & Backups
*.db
# SQLite-WAL-Modus legt Sidecar-Dateien neben die .db — die matcht *.db NICHT,
# deshalb wurden _smoke_a45.db-shm/-wal einmal versehentlich eingecheckt.
*.db-shm
*.db-wal
*.db.bak*
*.sqlite3
# Compose-Bind-Mounts (App-Daten + PostgreSQL-Datenverzeichnis)
/data/
/db/
# Isolierter Test-Cluster von tools/pg-test.ps1 (eigener Port, wegwerfbar)
backend/_pgtest/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Logs & lokale Prozess-Artefakte
backend/_server.log
backend/_server.err
backend/_test.err
*.log

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Hochgeladene Medien (Lebensdatenbank, Anm. 57 — separat sichern)
backend/media/
media/
# Die Bilder, die tools/_measure_api.py beim Messen anlegt (MEDIA_DIR-Vorgabe).
# `media/` matcht das NICHT — der Ordner heisst nicht „media" — und so sind mit
# 8820d67 einmal 926 Dateien / 20 MB Messartefakte in die Historie geraten.
_measure_media/

# Node steckt AUSSCHLIESSLICH in den Wächtern; die App hat keinen Build-Schritt
# (Anm. 4). package-lock.json ist bewusst NICHT ignoriert: die CI installiert
# damit dieselben Versionen wie hier, sonst prüft sie etwas anderes als du.
tools/node_modules/
